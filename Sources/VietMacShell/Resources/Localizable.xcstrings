    "setup.conflict.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ also changes what you type. Two input tools change your text twice. Quit %@ from its menu bar icon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cũng đang đổi chữ bạn gõ. Hai bộ gõ cùng lúc sẽ đổi chữ hai lần. Hãy thoát %@ từ biểu tượng của nó trên thanh menu."
          }
        }
      }
    },
    "setup.conflict.clear": {
      "extractionState": "manual",
      "localizations": {
