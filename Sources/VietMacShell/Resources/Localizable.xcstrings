    "setup.accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on VietMac in **Accessibility**. VietMac checks the caret position and the kind of field. It does not read text in other apps."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật VietMac trong **Trợ năng**. VietMac xem vị trí con trỏ và loại ô. VietMac không đọc chữ trong ứng dụng khác."
          }
        }
      }
    },
    "setup.accessibility.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow VietMac to change letters in the field you type in"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép VietMac đổi chữ trong ô bạn đang gõ"
          }
        }
      }
    },
    "setup.accessibility.reopenRow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
