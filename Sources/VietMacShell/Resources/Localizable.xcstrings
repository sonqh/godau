    "setup.accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Gõ Dấu in **Accessibility**. Gõ Dấu checks the caret position and the kind of field. It does not read text in other apps."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Gõ Dấu trong **Trợ năng**. Gõ Dấu xem vị trí con trỏ và loại ô. Gõ Dấu không đọc chữ trong ứng dụng khác."
          }
        }
      }
    },
    "setup.accessibility.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Gõ Dấu to change letters in the field you type in"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Gõ Dấu đổi chữ trong ô bạn đang gõ"
          }
        }
      }
    },
    "setup.accessibility.reopenRow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen Gõ Dấu to use the permission you turned on."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại Gõ Dấu để dùng quyền bạn vừa bật."
          }
        }
      }
    },
    "setup.accessibility.row": {
      "extractionState": "manual",
