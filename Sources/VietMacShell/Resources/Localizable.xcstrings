    "setup.grant.helpBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the switch off. Then turn it on again. If the window still shows \"Off\": 1. Select Gõ Dấu in the list. 2. Click **−**. 3. Click **Open System Settings** again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt công tắc. Sau đó bật lại. Nếu vẫn ghi \"Chưa bật\": 1. Chọn Gõ Dấu trong danh sách. 2. Bấm nút **−**. 3. Bấm **Mở Cài đặt Hệ thống** lần nữa."
          }
        }
      }
    },
    "setup.grant.helpTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch is on, but this window still shows \"Off\"?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc đã bật nhưng ở đây vẫn ghi \"Chưa bật\"?"
          }
        }
      }
    },
    "setup.grant.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button below."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm nút bên dưới."
          }
        }
      }
    },
    "setup.grant.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the switch next to Gõ Dấu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật công tắc cạnh Gõ Dấu."
          }
        }
      }
    },
    "setup.grant.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS asks, choose **Quit & Reopen**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu macOS hỏi, chọn **Thoát & Mở lại**."
          }
