    "setup.grant.helpBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the switch off. Then turn it on again. If the window still shows \"Off\": 1. Select VietMac in the list. 2. Click **−**. 3. Click **Open System Settings** again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt công tắc. Sau đó bật lại. Nếu vẫn ghi \"Chưa bật\": 1. Chọn VietMac trong danh sách. 2. Bấm nút **−**. 3. Bấm **Mở Cài đặt Hệ thống** lần nữa."
          }
        }
      }
    },
    "setup.grant.helpTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch is on, but this window still shows \"Off\"?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc đã bật nhưng ở đây vẫn ghi \"Chưa bật\"?"
          }
        }
      }
    },
