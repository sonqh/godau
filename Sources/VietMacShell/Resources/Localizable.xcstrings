        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật lại quyền cho VietMac"
          }
        }
      }
    },
    "setup.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VietMac changes `tieengs` to `tiếng` while you type. Setup takes about two minutes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VietMac đổi `tieengs` thành `tiếng` ngay khi bạn gõ. Thiết lập mất khoảng hai phút."
          }
        }
      }
    },
