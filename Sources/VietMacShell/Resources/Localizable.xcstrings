    "setup.update.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an update, macOS may not recognize Gõ Dấu. Turn the switch off. Then turn it on again. If that does not help, remove Gõ Dấu from the list. Then add it again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi cập nhật, macOS có thể không nhận ra Gõ Dấu. Tắt công tắc. Sau đó bật lại. Nếu chưa được, hãy xoá Gõ Dấu khỏi danh sách. Sau đó thêm lại."
          }
        }
      }
    },
    "setup.update.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On the Gõ Dấu Permission Again"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật lại quyền cho Gõ Dấu"
          }
        }
      }
    },
    "setup.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ Dấu changes `tieengs` to `tiếng` while you type. Setup takes about two minutes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ Dấu đổi `tieengs` thành `tiếng` ngay khi bạn gõ. Thiết lập mất khoảng hai phút."
          }
        }
      }
    },
    "setup.welcome.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type Vietnamese with Telex, no underline"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ tiếng Việt kiểu Telex, không gạch chân"
          }
        }
      }
    },
    "setup.welcome.otherTool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you use OpenKey, EVKey, or another Vietnamese input tool, quit it first."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đang dùng OpenKey, EVKey hay bộ gõ tiếng Việt khác, hãy thoát nó trước."
          }
        }
      }
    },
    "setup.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ Dấu does not read text in other apps. It does not store or send what you type. It does not use the network."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ Dấu không đọc chữ trong ứng dụng khác. Gõ Dấu không lưu và không gửi chữ bạn gõ. Gõ Dấu không dùng mạng."
          }
        }
      }
    },
    "setup.welcome.start": {
