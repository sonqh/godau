    "setup.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VietMac does not read text in other apps. It does not store or send what you type. It does not use the network."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VietMac không đọc chữ trong ứng dụng khác. VietMac không lưu và không gửi chữ bạn gõ. VietMac không dùng mạng."
          }
        }
      }
    },
