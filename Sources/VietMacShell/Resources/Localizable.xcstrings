    "setup.update.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an update, macOS may not recognize VietMac. Turn the switch off. Then turn it on again. If that does not help, remove VietMac from the list. Then add it again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi cập nhật, macOS có thể không nhận ra VietMac. Tắt công tắc. Sau đó bật lại. Nếu chưa được, hãy xoá VietMac khỏi danh sách. Sau đó thêm lại."
          }
        }
      }
    },
    "setup.update.heading": {
      "extractionState": "manual",
      "localizations": {
