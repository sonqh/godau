{
  "schemaVersion": 1,
  "family": "autocomplete",
  "scenarios": [
    {
      "id": "address-inline-completion",
      "version": 2,
      "rules": "m0",
      "apps": [
        "chrome",
        "dia",
        "safari"
      ],
      "surface": "address",
      "seed": [
        "127.0.0.1:8765/aaron-test.html"
      ],
      "script": {
        "steps": [
          {
            "key": "l",
            "modifiers": [
              "command"
            ]
          },
          {
            "pause": 300
          },
          {
            "text": "127.0.0.1:8765/a",
            "interval": 60,
            "hold": 30
          },
          {
            "checkpoint": "completion",
            "settle": 800
          },
          {
            "text": "s"
          },
          {
            "checkpoint": "final",
            "settle": 800
          },
          {
            "key": "escape"
          },
          {
            "key": "escape"
          }
        ]
      },
      "checkpoints": {
        "completion": {
          "selected": true,
          "prefix": "127.0.0.1:8765/a"
        },
        "final": {
          "value": "127.0.0.1:8765/á"
        }
      },
      "replacements": 1,
      "withoutInlineCompletion": {
        "final": {
          "value": "127.0.0.1:8765/á"
        },
        "replacements": 1
      },
      "minimum": {
        "addressBarReplacements": 1
      },
      "note": "v2 (Son, 2026-11-15): address bars use the event-only addressBar profile. With an inline completion shown after /a, typing s removes the completion with one forward Delete and gives /á. v1 expected /as (AD-11, literal while a completion is shown)."
    }
  ]
}
