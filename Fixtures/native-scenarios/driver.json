{
  "schemaVersion": 1,
  "family": "driver",
  "scenarios": [
    {
      "id": "probe-command-chord",
      "version": 1,
      "rules": "m0",
      "apps": [
        "chrome",
        "dia",
        "safari"
      ],
      "field": "area",
      "script": {
        "steps": [
          {
            "key": "a",
            "modifiers": [
              "command"
            ]
          },
          {
            "text": "x"
          }
        ]
      },
      "expect": {
        "area": "x"
      },
      "replacements": 0
    },
    {
      "id": "interference-probe",
      "version": 1,
      "rules": "m0",
      "apps": [
        "chrome"
      ],
      "field": "area",
      "keys": " the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog",
      "interval": 120,
      "hold": 60,
      "expectDriverAbort": "userInterference",
      "note": "Son moves the mouse during the run; the driver must stop with userInterference.",
      "expect": {},
      "replacements": 0
    }
  ]
}
